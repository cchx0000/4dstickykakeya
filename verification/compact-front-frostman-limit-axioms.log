StickyKakeya4.CompactFrontLimit.exists_frostman_probability_subseq.{u_1} {E : Type u_1} [MetricSpace E]
  [MeasurableSpace E] [BorelSpace E] [TopologicalSpace.SeparableSpace E] {K : Set E} (hK : IsCompact K)
  (μs : ℕ → MeasureTheory.ProbabilityMeasure E) (hsupport : ∀ (n : ℕ), ↑(μs n) Kᶜ = 0) (ρ : ℕ → ℝ)
  (hρ : Filter.Tendsto ρ Filter.atTop (nhds 0)) (C : ENNReal) (d : ℝ)
  (hball : ∀ (n : ℕ) (x : E) (r : ℝ), 0 < r → ρ n ≤ r → r ≤ 1 → ↑(μs n) (Metric.ball x r) ≤ C * ENNReal.ofReal r ^ d) :
  ∃ μ,
    ↑μ Kᶜ = 0 ∧
      ∃ φ,
        StrictMono φ ∧
          Filter.Tendsto (μs ∘ φ) Filter.atTop (nhds μ) ∧
            ∀ (x : E) (r : ℝ), 0 < r → r ≤ 1 → ↑μ (Metric.ball x r) ≤ C * ENNReal.ofReal r ^ d
