StickyKakeya4.selector_closure : ∀ (ambient selector : Set StickyKakeya4.MarkedLine),
  IsCompact ambient →
    selector ⊆ ambient →
      MeasurableSet selector →
        (∀ line ∈ selector, StickyKakeya4.IsValidLine line) →
          StickyKakeya4.IsDirectionSelector selector →
            StickyKakeya4.packingDim (StickyKakeya4.lineCarrier selector) = 3 →
              dimH (StickyKakeya4.unitFront ambient) = 4
def StickyKakeya4.IsStickyDatum : Set StickyKakeya4.MarkedLine → Prop :=
fun lines =>
  IsCompact lines ∧
    (∀ line ∈ lines, StickyKakeya4.IsValidLine line) ∧
      StickyKakeya4.FullDirection lines ∧ StickyKakeya4.packingDim (StickyKakeya4.lineCarrier lines) ≤ 3
def StickyKakeya4.HasUniformMarkedSourceEstimate : Set StickyKakeya4.MarkedLine → Prop :=
fun selector =>
  ∀ (ε : ℝ),
    0 < ε →
      ∀ (Cpack : ENNReal),
        Cpack ≠ 0 →
          Cpack ≠ ⊤ →
            ∃ A,
              A ≠ 0 ∧
                A ≠ ⊤ ∧
                  ∃ δ₀,
                    0 < δ₀ ∧
                      ∀ (n : ℕ) (D R : StickyKakeya4.FiniteScaleSource n),
                        D.thickness ≤ δ₀ →
                          StickyKakeya4.ComesFromSelector D selector →
                            StickyKakeya4.IsAdmissibleStickySource D (ε / 10) Cpack →
                              StickyKakeya4.IsFractionalSourceRestriction R D →
                                StickyKakeya4.sourceMass R ≤
                                  A * (ENNReal.ofReal D.thickness).rpow (-ε) *
                                    MeasureTheory.volume (StickyKakeya4.sourceUnion R)
