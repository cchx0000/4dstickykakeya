def StickyKakeya4.FourDistinctSources.FourDistinct.{u_1} : {ι : Type u_1} → ι → ι → ι → ι → Prop :=
fun {ι} i j k l => i ≠ j ∧ i ≠ k ∧ i ≠ l ∧ j ≠ k ∧ j ≠ l ∧ k ≠ l
def StickyKakeya4.FourDistinctSources.tripleExpectation.{u_1} : {ι : Type u_1} →
  [Fintype ι] → (ι → ℝ) → (ι → ι → ι → ℝ) → ℝ :=
fun {ι} [Fintype ι] p f => ∑ j, ∑ k, ∑ l, p j * p k * p l * f j k l
def StickyKakeya4.FourDistinctSources.tripleProbability.{u_1} : {ι : Type u_1} →
  [Fintype ι] → (ι → ℝ) → (ι → ι → ι → Prop) → ℝ :=
fun {ι} [Fintype ι] p E => StickyKakeya4.FourDistinctSources.tripleExpectation p fun j k l => if E j k l then 1 else 0
def StickyKakeya4.FourDistinctSources.fourDistinctProbability.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℝ) → ι → ℝ :=
fun {ι} [Fintype ι] p i =>
  StickyKakeya4.FourDistinctSources.tripleProbability p (StickyKakeya4.FourDistinctSources.FourDistinct i)
def StickyKakeya4.FourDistinctSources.normalizedWeights.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℝ) → ι → ℝ :=
fun {ι} [Fintype ι] w j => w j / ∑ k, w k
