StickyKakeya4.collisionTimeFiber_volume_le (J : Set ℝ) (α β : StickyKakeya4.E3) (hα : α ≠ 0) (ρ : ℝ) (hρ : 0 ≤ ρ) :
  MeasureTheory.volume (StickyKakeya4.collisionTimeFiber J α β ρ) ≤ ENNReal.ofReal (2 * ρ / ‖α‖)
StickyKakeya4.collisionTimeFiber_volume_le_localized (α β : StickyKakeya4.E3) (hα : α ≠ 0) (u v ρ : ℝ) (hρ : 0 ≤ ρ) :
  MeasureTheory.volume (StickyKakeya4.collisionTimeFiber (Set.Icc u v) α β ρ) ≤
    if
        ‖StickyKakeya4.collisionResidual α β‖ ≤ ρ ∧
          StickyKakeya4.collisionTime α β ∈ Set.Icc (u - ρ / ‖α‖) (v + ρ / ‖α‖) then
      ENNReal.ofReal (2 * ρ / ‖α‖)
    else 0
