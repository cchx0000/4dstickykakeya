StickyKakeya4.OriginalResidualCriterion.compact_full_direction_residual_reduction
  (ambient : Set StickyKakeya4.MarkedLine) (hcompact : IsCompact ambient)
  (hvalid : ∀ line ∈ ambient, StickyKakeya4.IsValidLine line) (hfull : StickyKakeya4.FullDirection ambient) :
  ∃ σ b u v,
    MeasureTheory.IsFiniteMeasure σ ∧
      0 < σ Set.univ ∧
        σ ≤ MeasureTheory.volume ∧
          Measurable b ∧
            v - u = 3 / 8 ∧
              (∀ᵐ (a : StickyKakeya4.E3) ∂σ, ‖a‖ ≤ 1) ∧
                (∀ᵐ (a : StickyKakeya4.E3) ∂σ,
                    ∀ s ∈ Set.Icc u v,
                      StickyKakeya4.ActualSlopeSource.heightPoint (b a + s • a) s ∈ StickyKakeya4.unitFront ambient) ∧
                  (StickyKakeya4.OriginalResidualCriterion.HasResidualPowerBounds σ b u v →
                    dimH (StickyKakeya4.unitFront ambient) = 4)
