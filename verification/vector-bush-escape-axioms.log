StickyKakeya4.VectorBushEscape.closed_cap_sum_le_of_open_cap_sum {m : ℕ}
  (σ : Fin m → MeasureTheory.Measure StickyKakeya4.E3) (z : Fin m → StickyKakeya4.E3) (ρ R d : ℝ) (C : ENNReal)
  (hρ : 0 < ρ) (hd : 0 ≤ d) (hρR : ρ ≤ R) (hR1 : R ≤ 1)
  (hopen :
    ∀ (T : ℝ),
      ρ ≤ T →
        T ≤ 1 →
          ∑' (i : Fin m), (σ i) (Metric.ball (z i) T) ≤
