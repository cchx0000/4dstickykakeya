@StickyKakeya4.measure_edge_flow_conservation_apply : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {n : ℕ}
  (T : StickyKakeya4.NestedCarrierTree n) (incoming paid terminal : Fin n → MeasureTheory.Measure Ω),
  (∀ (i : Fin n), incoming i = paid i + terminal i + ∑ j, if T.parent j = some i then incoming j else 0) →
